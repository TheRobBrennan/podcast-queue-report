# Copy this file to .env and fill in your own values.
# .env is gitignored — your personal info never gets committed.

# Path to Apple Podcasts' local library database. Leave blank to
# auto-detect the standard macOS location.
PODCASTS_DB_PATH=

# IANA timezone for "today" / "this week" / "this month" boundaries and
# displayed dates & times. Defaults to UTC if unset.
REPORT_TIMEZONE=America/New_York

# Your name, used as the email sign-off. Leave blank to omit it.
REPORT_SIGNOFF_NAME=Your Name

# Where reports get emailed / texted to. `make email` sends via
# Outlook and `make sms` sends via Messages.app (both AppleScript,
# macOS only) - leave either blank/commented to skip that channel, same
# as DISCORD_WEBHOOK_URL below.
REPORT_EMAIL=you@example.com
REPORT_PHONE=555-555-5555

# Label used to build the email subject line, e.g.
# "Podcast Queue Report — Grade B+ (2.5 days behind)".
REPORT_LABEL=Podcast Queue Report

# Discord webhook URL for posting the daily chat summary automatically.
# Create one in Discord: Server Settings -> Integrations -> Webhooks.
# Leave blank to skip Discord posting.
DISCORD_WEBHOOK_URL=
